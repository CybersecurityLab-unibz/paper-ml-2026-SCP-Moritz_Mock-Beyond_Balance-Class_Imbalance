#!/bin/bash

#SBATCH -A IscrC_AGENT
#SBATCH -p boost_usr_prod
#SBATCH --time 1-0:00:00       # format: HH:MM:SS
#SBATCH -N 1                  # 1 node
#SBATCH --ntasks-per-node=1   # 1 tasks out of 32
#SBATCH --gres=gpu:1          # 1 gpus per node out of 4
#SBATCH --mem=90000          # memory per node out of 494000MB
#SBATCH --job-name=TrainDeepSeekCoder
#SBATCH --output=/leonardo/home/userexternal/mmock000/NLBSE_journal_extension/logs/%j.out       # the standard output is written to this file
#SBATCH --error=/leonardo/home/userexternal/mmock000/NLBSE_journal_extension/logs/%j.err        # the standard error is written to this file

module load cuda/12.1
module load python/3.10.8--gcc--8.5.0

cd /leonardo/home/userexternal/mmock000/NLBSE_journal_extension

echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

source  /leonardo/home/userexternal/mmock000/NLBSE_journal_extension/env/bin/activate

echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

nvidia-smi

LANGUAGE=$1
LOSS=$2
EPOCH=$3
BATCHSIZE=$4
LR=$5
WD=$6

nlbse_jex \
  --weighted-loss ${LOSS} \
  --epoch ${EPOCH} \
  --train data/NLBSE25/${LANGUAGE}/${LANGUAGE}_train.csv \
  --test data/NLBSE25/${LANGUAGE}/${LANGUAGE}_test.csv \
  --batch-size ${BATCHSIZE} \
  --lr ${LR} \
  --weight-decay ${WD} \
  --column-key-text combo \
  --column-key-label labels \
  --result-path /leonardo_work/IscrC_AGENT/NLBSE_journal/results \
  --model-path sentence-transformers/paraphrase-MiniLM-L6-v2
