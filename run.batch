#!/bin/bash

#SBATCH --job-name=Test_DeepSeeker # job name in accounting
#SBATCH --output=/data/users/momock/NLBSE_JEX/%j.out # the standard output is written to this file
#SBATCH --error=/data/users/momock/NLBSE_JEX/%j.err # the standard error is written to this file
#SBATCH --partition=gpu-low #cluster partition to use, you may not have access to this one
#SBATCH --ntasks-per-node=4 # use four cores
#SBATCH --nodes=1 # use a single cluster node
#SBATCH --mem=80G
#SBATCH --time=5-0:00:00
#SBATCH --gres=gpu:v100
#SBATCH --account=ml-vuln
#SBATCH --partition=gpu-low

cd /home/clusterusers/momock/NLBSE_journal_extension
module purge
echo "Should be empty"
module list

module load python/3.10.8-gcc-12.1.0-linux-ubuntu22.04-zen2
module load cuda/11.8

echo "Loaded moduleLoaded modules"
module list

echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

source  env/bin/activate
echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

nvidia-smi

LANGUAGE=$1
LOSS=$2
EPOCH=$3
BATCHSIZE=$4
LR=$5
WD=$6

nlbse_jex \
  --weighted-loss ${LOSS} \
  --epoch ${EPOCH} \
  --train data/NLBSE25/${LANGUAGE}/${LANGUAGE}_train.csv \
  --test data/NLBSE25/${LANGUAGE}/${LANGUAGE}_test.csv \
  --batch-size ${BATCHSIZE} \
  --lr ${LR} \
  --weight-decay ${WD} \
  --column-key-text combo \
  --column-key-label labels \
  --result-path /data/users/momock/NLBSE_JEX/results \
  --model-path sentence-transformers/paraphrase-MiniLM-L6-v2
