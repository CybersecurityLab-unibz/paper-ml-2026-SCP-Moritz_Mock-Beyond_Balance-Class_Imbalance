#!/bin/bash

#SBATCH --job-name=Test_DeepSeeker # job name in accounting
#SBATCH --output=/data/users/momock/NLBSE_JEX/logs/%j.out # the standard output is written to this file
#SBATCH --error=/data/users/momock/NLBSE_JEX/logs/%j.err # the standard error is written to this file
#SBATCH --partition=gpu-low #cluster partition to use, you may not have access to this one
#SBATCH --ntasks-per-node=4 # use four cores
#SBATCH --nodes=1 # use a single cluster node
#SBATCH --mem=80G
#SBATCH --time=21-0:00:00
#SBATCH --gres=gpu:v100 #gpu:a100-sxm4-80gb
#SBATCH --account=ml-vuln
#SBATCH --partition=gpu-low

cd /home/clusterusers/momock/NLBSE_journal_extension
module purge
echo "Should be empty"
module list

module load python/3.10.8-gcc-12.1.0-linux-ubuntu22.04-zen2
module load cuda/11.8

echo "Loaded moduleLoaded modules"
module list

echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

source  env/bin/activate
echo $(python <<EOF
import sys
if sys.prefix == sys.base_prefix:
        print("No, you are not in a virtual environment.")
else:
        print("Yes, you are in a virtual environment.")
EOF
)

nvidia-smi

LANGUAGE=$1
DATASET=$2
MODEL=$3

nlbse_jex \
  --weighted-loss EW ICF RBF \
  --epoch 5 10 \
  --train data/${DATASET}/${LANGUAGE}/${LANGUAGE}_train.csv \
  --test data/${DATASET}/${LANGUAGE}/${LANGUAGE}_test.csv \
  --batch-size 8 16 32 \
  --lr 1e-2 1e-3 \
  --weight-decay 0 0.01 0.001 \
  --column-key-text combo \
  --column-key-label labels \
  --result-path /data/users/momock/NLBSE_JEX/results \
  --model-path ${MODEL}
